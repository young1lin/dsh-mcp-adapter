{
  "name": "dsh-mcp-adapter",
  "version": "0.3.1",
  "type": "module",
  "description": "DeepSeek Harness plugin unifying MCP servers, SSH tunnels and connections management (mounts standard .mcp.json plus an embedded managed engine).",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./engine": {
      "types": "./dist/engine/engine-main.d.ts",
      "default": "./dist/engine/engine-main.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-engine-assets.mjs && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:engine": "vitest run --config vitest.engine.config.ts",
    "build:client": "esbuild src/client/index.ts --bundle --format=esm --outfile=dist/client.js --platform=browser --legal-comments=none"
  },
  "files": [
    "dist",
    ".agents/skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "mcp",
    "model-context-protocol",
    "mcp-json",
    "adapter",
    "plugin",
    "local-mcp-gateway",
    "ssh-tunnel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young1lin/dsh-mcp-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/young1lin/dsh-mcp-adapter/issues"
  },
  "homepage": "https://github.com/young1lin/dsh-mcp-adapter#readme",
  "author": "young1lin",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^6.0.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.4"
  }
}
